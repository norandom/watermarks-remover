# core/ came from upstream, and NOTICE records the SHA-256 of each file at the
# point of copying, computed over LF bytes. Pinning core/ to LF keeps that
# record checkable and keeps a diff against upstream meaningful.
src/wm_hook/core/** text eol=lf

# Line endings are part of what this tool preserves, so git must not rewrite
# the sources that implement that, nor the fixtures that prove it. A
# CRLF-mangled fixture silently invalidates the fidelity tests.
src/wm_hook/*.py text eol=lf
tests/corpus/** -text
*.sh text eol=lf
